{
  "hosting": [
    {
      "target": "calculator",
      "public": "out",
      "ignore": ["firebase.json", "**/node_modules/**"],
      "redirects": [
        {
          "source": "/",
          "destination": "https://dissid.ai/",
          "type": 301
        },
        {
          "source": "/**",
          "destination": "https://dissid.ai/",
          "type": 301
        }
      ]
    },
    {
      "target": "consultancy",
      "public": "out",
      "ignore": ["firebase.json", "**/node_modules/**"],
      "cleanUrls": true
    }
  ]
}
