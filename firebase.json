{
  "hosting": {
    "target": "calculator",
    "public": "out",
    "ignore": [
      "firebase.json",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/",
        "destination": "https://dissid.ai/",
        "type": 301
      },
      {
        "source": "/**",
        "destination": "https://dissid.ai/",
        "type": 301
      }
    ]
  }
}
