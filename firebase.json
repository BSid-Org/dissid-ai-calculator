{
  "hosting": [
    {
      "target": "calculator",
      "public": "out",
      "ignore": ["firebase.json", "**/node_modules/**"],
      "redirects": [
        {
          "source": "/",
          "destination": "https://dissid.ai/",
          "type": 301
        },
        {
          "source": "/**",
          "destination": "https://dissid.ai/",
          "type": 301
        }
      ]
    },
    {
      "target": "consultancy",
      "public": "out",
      "ignore": ["firebase.json", "**/node_modules/**"],
      "cleanUrls": true,
      "headers": [
        {
          "source": "**",
          "headers": [
            { "key": "X-Content-Type-Options", "value": "nosniff" },
            { "key": "X-Frame-Options", "value": "DENY" },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            },
            {
              "key": "Cache-Control",
              "value": "public, max-age=0, must-revalidate"
            }
          ]
        },
        {
          "source": "/_next/static/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        }
      ]
    }
  ]
}
